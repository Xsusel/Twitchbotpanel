[Unit]
Description=XSUS Sentinel Web Application
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/xsus_sentinel
Environment="PATH=/opt/xsus_sentinel/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/opt/xsus_sentinel/.env
ExecStart=/opt/xsus_sentinel/venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 "app:create_app()"

[Install]
WantedBy=multi-user.target
