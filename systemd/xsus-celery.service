[Unit]
Description=XSUS Sentinel Celery Worker
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/xsus_sentinel
Environment="PATH=/opt/xsus_sentinel/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/opt/xsus_sentinel/.env
ExecStart=/opt/xsus_sentinel/venv/bin/celery -A celery_worker.celery worker --loglevel=info
Restart=always

[Install]
WantedBy=multi-user.target
